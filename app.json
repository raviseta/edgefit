{
  "expo": {
    "name": "EdgeFit",
    "slug": "edgefit",
    "scheme": "edgefit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.edgefit.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.edgefit.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "EdgeFit reads your steps, active energy, exercise minutes and workouts to calculate activity summaries on this device. Your health data is not uploaded anywhere.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
